// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 읽기 세션 모델
model Session {
  id                String   @id @default(cuid())
  title             String   @default("새로운 읽기 세션")
  description       String?
  duration          Int      // 분 단위
  wordCount         Int      @default(0)
  readingSpeed      Float    @default(0) // 단어/분
  comprehension     Float    @default(0) // 0-100
  status            String   @default("completed") // completed, in_progress, paused
  mcpNotePath       String?  // MCP 노트 경로
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // 관계
  notes Note[]
  aiAnalyses AIAnalysis[]
  trainingPlans TrainingPlan[]

  @@map("sessions")
}

// 노트 모델
model Note {
  id          String   @id @default(cuid())
  sessionId   String?
  path        String   // 노트 경로
  content     String
  metadata    String?  // JSON string of metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([path])
  @@map("notes")
}

// 훈련 계획 모델
model TrainingPlan {
  id          String   @id @default(cuid())
  sessionId   String?
  name        String
  description String?
  exercises   String   // JSON string of exercises array
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 관계
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("training_plans")
}

// 성취 모델
model Achievement {
  id          String   @id @default(cuid())
  type        String   // session_count, speed_improvement, comprehension_improvement, etc.
  title       String
  description String
  icon        String?
  unlockedAt  DateTime @default(now())

  @@map("achievements")
}

// AI 분석 결과 모델
model AIAnalysis {
  id            String   @id @default(cuid())
  sessionId     String
  analysisType  String   // session_analysis, recommendation, plan_generation
  analysis      String   // JSON string of analysis
  createdAt     DateTime @default(now())

  // 관계
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

// 성과 통계 모델
model PerformanceStats {
  id                    String   @id @default(cuid())
  totalSessions         Int      @default(0)
  totalDuration         Int      @default(0) // 분 단위
  totalWordsRead        Int      @default(0)
  averageComprehension  Float    @default(0)
  bestComprehension     Int      @default(0)
  averageSpeed          Float    @default(0) // 단어/분
  lastSessionDate       DateTime?
  updatedAt             DateTime @updatedAt

  @@map("performance_stats")
}

// 개인 기록용 포스트 모델
model Post {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  likes     Like[]
}

// 개인 기록용 댓글 모델
model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
}

// 개인 기록용 좋아요 모델
model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@unique([postId])
}
